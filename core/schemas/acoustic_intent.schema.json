{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nocturne.castalia.institute/acoustic-intent.schema.json",
  "title": "AcousticIntentEnvelope",
  "type": "object",
  "required": [
    "schemaVersion",
    "seed",
    "sessionId",
    "monotonicMs",
    "sourceDomain",
    "intent"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "sessionId": {
      "type": "integer",
      "minimum": 0
    },
    "monotonicMs": {
      "type": "number",
      "minimum": 0
    },
    "sourceDomain": {
      "type": "string",
      "enum": ["observed", "computed", "symbolic", "user"]
    },
    "intent": {
      "type": "object",
      "required": ["grounding", "brightness", "warmth", "density", "motion", "spaciousness", "silence", "eventActivity", "harmonicTension", "novelty"],
      "properties": {
        "grounding": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "brightness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "warmth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "density": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "motion": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "spaciousness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "silence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eventActivity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "harmonicTension": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "novelty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "influences": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["value", "confidence", "minBound", "maxBound", "provenanceWeight"],
        "properties": {
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minBound": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "maxBound": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "provenanceWeight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
